import base.print
import base.range
import fs
import io

const name = "__test_close_race"
fs.remove(name)
defer { fs.remove(name) }

with const f = io.create(name) {
    f.resize(100_000)
}

var stop   = false
var shared = io.open(name, io.ro)

fun reader
{
    while ! stop {
        try {
            shared.read_some(1)
        }
        catch const e {
        }
    }
}

const t = reader.async()

for _ in range(5000) {
    try {
        shared.close()
    }
    catch const e {
    }

    shared = io.open(name, io.ro)
}

stop = true
t.wait()
shared.close()
