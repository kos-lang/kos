import base

var cache = { }

public class re
{
    constructor(regex) {
        if ! (regex in cache) {
            cache[regex] = re_uncached(regex)
        }
        this.regex  = cache[regex]
        this.string = regex
    }

    fun find(string, begin = 0, end = void, anchor = void) {
        return this.regex.find(string, begin, end, anchor)
    }

    /* @item re re.prototype.find_all()
     *
     *     re.prototype.find_all(string)
     *
     * A generator which produces all matches of the regular expression
     * in the string.
     *
     * Returns an iterator function, which yields match objects on
     * subsequent invocations.  The yielded match objects are the same
     * objects which `find` returns.
     *
     * `string` is the string in which the regular expression is matched.
     *
     * Unlike `find`, which matches `^` at the position given by `begin`,
     * this function matches `^` at the beginning of the string and after
     * any end-of-line character.
     *
     * Example:
     *
     *     > re(r"\w+").find_all("hello world") -> each(m => print(m.match))
     *     hello
     *     world
     *     2
     */
    fun find_all(string) {

        var pos = 0

        loop {
            const found = this.regex.find(string, pos, void, 0)
            if found == void {
                return
            }

            yield found

            pos = found.end

            if pos == string.size {
                return
            }

            if pos == found.begin {
                pos = pos + 1
            }
        }
    }

    /* @item re re.prototype.replace()
     *
     *     re.prototype.replace(string, replacement)
     *
     * Replaces all matches of the regular expression in the string.
     *
     * Returns a new string in which each match is replaced.  The
     * original string is not modified.
     *
     * `string` is the string in which the regular expression is matched.
     *
     * `replacement` is either a string, which replaces each match, or a
     * function, which is called with the match object and which returns
     * the replacement string.
     *
     * The `^` pattern matches at the beginning of the string and after
     * any end-of-line character, like in `find_all`.
     *
     * Example:
     *
     *     > re(r"\d+").replace("a1 b22", "#")
     *     "a# b#"
     */
    fun replace(string, replacement) {
        const pieces = []
        var   pos    = 0

        for const found in this.find_all(string) {
            if found.begin > pos {
                pieces.push(string[pos : found.begin])
            }

            pieces.push((typeof replacement == "function") ? replacement(found) : replacement)

            pos = found.end
        }

        if pos < string.size {
            pieces.push(string[pos :])
        }

        return base.string.apply(void, pieces)
    }
}

/* @item re clear_cache()
 *
 *     clear_cache()
 *
 * Clears regular expression cache.
 *
 * The `re` class stores regular expressions in a cache, which can be
 * emptied with this function.
 *
 * Example:
 *
 *     > clear_cache()
 */
public fun clear_cache
{
    cache = { }
}
